# Only needed to run TraceBill outside Docker. With `docker compose up` the
# telemetry backend is bootstrapped automatically and none of this is required.

# Where the telemetry backend is reachable.
SIGNOZ_URL=http://localhost:8080
SIGNOZ_OTLP=http://localhost:4318

# Operator credentials for the backend's query API. `npm run signoz:bootstrap`
# creates this account and saves these values to data/signoz-operator.json, which
# is read automatically — so you normally leave this section empty.
# SIGNOZ_EMAIL=
# SIGNOZ_PASSWORD=
# SIGNOZ_ORG_ID=

# An access token is preferred over the account above, and wins if set. SigNoz
# v0.134.0 has no working API to mint one (see docs/ARCHITECTURE.md).
# SIGNOZ_PAT=

# Signs the per-invoice share links. Changing it invalidates every link already
# sent to a customer.
SHARE_TOKEN_SECRET=change-me

# Shared secret for POST /api/v1/webhooks/quota-alert.
TRACEBILL_WEBHOOK_SECRET=change-me

# Optional:
# PERIOD_MINUTES=5
# METER_INTERVAL_MS=15000
# CLOSE_GRACE_MS=20000
