# TraceBill operator config. Copy to .env and fill in.
# These are TraceBill's own credentials for its telemetry backend; tenants never
# see this file or anything in it.

SIGNOZ_URL=http://localhost:8080
SIGNOZ_OTLP=http://localhost:4318

# Preferred: a personal access token from the SigNoz UI (Settings -> API keys),
# sent as the SIGNOZ-API-KEY header.
SIGNOZ_PAT=

# Fallback if no PAT is available: the engine signs in and refreshes a session
# JWT every 20 minutes. SIGNOZ_ORG_ID comes from the login response.
SIGNOZ_EMAIL=
SIGNOZ_PASSWORD=
SIGNOZ_ORG_ID=

# Signs the deterministic per-invoice share tokens. Changing it invalidates
# every link already sent to an end customer.
SHARE_TOKEN_SECRET=change-me

# Shared secret for POST /api/v1/webhooks/quota-alert.
TRACEBILL_WEBHOOK_SECRET=change-me

# Optional overrides:
# PERIOD_MINUTES=5
# METER_INTERVAL_MS=15000
# CLOSE_GRACE_MS=20000
